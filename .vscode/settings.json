{
  "editor.formatOnSave": true,

  // Workspace root venv (uv puts it here for the whole workspace)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",

    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Pytest across both packages — discovers via per-package testpaths
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["binary-gen/tests", "training/tests"],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "rust-analyzer.linkedProjects": ["reference/src_rust/hello/Cargo.toml"]
}
